<!DOCTYPE html>
<html>
<head>
    <title>Frontend Form</title>
</head>
<body>
    <h2>User Form</h2>

    <form method="POST" action="/submit">
        <label>Name:</label>
        <input type="text" name="name" required><br><br>

        <label>Email:</label>
        <input type="email" name="email" required><br><br>

        <button type="submit">Submit</button>
    </form>

    <% if (response) { %>
        <h3>Response from Backend:</h3>
        <p><%= response %></p>
    <% } %>
</body>
</html>
